.DS_Store
Thumbs.db
*.swp
*.swo

# Ignore log files
*.log


# =====================================================
# ENVIRONMENT FILES
# =====================================================

# Main env file
# Uncomment below if you don't want .env in git
# .env

.env.backup
.env.production
.env.local
.env.testing


